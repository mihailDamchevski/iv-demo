{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "strict": true,
        "esModuleInterop": true,
        "moduleResolution": "node",
        "skipLibCheck": true,
        "types": ["node", "playwright/test"],
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "include": ["**/*.ts", "../playwright.config.ts"],
    "exclude": ["node_modules", "dist"]
}
